# Set default behavior: auto-normalize line endings for all text files
* text=auto

# Force LF line endings for shell scripts and executable files
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Force LF for common configuration and build files that require it
Makefile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Force CRLF for files that specifically require Windows line endings (optional)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Mark binary files explicitly so Git leaves them untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.exe binary
*.ico binary