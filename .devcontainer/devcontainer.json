{
    "name": "ROS 2 Humble",

    "dockerComposeFile": [
        "docker-compose.yml",
        "docker-compose.override.yml"
    ],
    "service": "ros2",
    "workspaceFolder": "/workspaces/warrior",

    // Runs on the host before every build/rebuild, so "Reopen in
    // Container" / "Rebuild Container" is still the only command you
    // ever have to run. NOTE: on Windows this only runs as bash if VS
    // Code is attached to WSL2 when it launches (open via `code .` from
    // a WSL2 terminal, or "Reopen in WSL" first). Otherwise, run
    // `.devcontainer/setup.sh` manually from a WSL2 terminal once
    // before rebuilding.
    "initializeCommand": "bash .devcontainer/setup.sh",

    "forwardPorts": [6080],
    "portsAttributes": {
        "6080": {
            "label": "Robot GUI (noVNC) — open in browser",
            "onAutoForward": "openBrowser"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "ms-python.python"
            ]
        }
    },

    "remoteUser": "vscode"

    // Manual overrides (re-run, then Rebuild Container):
    //   ./setup.sh --accel=software   force software rendering
    //   ./setup.sh --gui=false        headless, no GUI stack at all
}
